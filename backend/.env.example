PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000
# error | warn | info | http | debug. Default: debug in development, http in production.
# LOG_LEVEL=debug

# Must match the POSTGRES_* values in the repo-root .env (see .env.example),
# which is where the compose service gets its credentials.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/task_assignment?schema=public"

# Optional. Enables LLM inference of required skills for tasks created without
# any (Google AI Studio, free tier). Leave empty to skip inference.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
