# Credentials for the Postgres container in docker-compose.yml.
# Copy to `.env` (gitignored) before `bun run db:up` — compose fails fast if
# any of these is missing rather than defaulting to a weak password.
#
# Whatever you set here must match DATABASE_URL in backend/.env.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=task_assignment
POSTGRES_PORT=5432
