# Configuration for docker-compose.yml. Copy to `.env` (gitignored).
#
# Postgres credentials. Compose fails fast if any is missing rather than
# defaulting to a weak password. The backend container's DATABASE_URL is
# derived from these, so keep POSTGRES_PASSWORD URL-safe (no @ / : % #) or
# percent-encode it. When running the apps on the host instead, backend/.env
# must match these values.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=task_assignment
POSTGRES_PORT=5432

# Optional. Enables LLM inference of required skills for tasks created without
# any (Google AI Studio, free tier). Leave empty to skip inference.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# Host ports for the app containers.
BACKEND_PORT=4000
FRONTEND_PORT=3000

# Only when serving from somewhere other than localhost. Change both together:
# the browser calls the API on NEXT_PUBLIC_API_URL (baked in at image build,
# so rebuild), and the backend must allow the frontend's origin.
# NEXT_PUBLIC_API_URL=http://localhost:4000
# CORS_ORIGINS=http://localhost:3000
